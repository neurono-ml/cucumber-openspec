{
  "name": "cucumber-openspec",
  "version": "1.0.0",
  "private": true,
  "description": "Convert OpenSpec specs to Cucumber/Gherkin feature files",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.ts"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.0",
    "@cucumber/messages": "^34.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
